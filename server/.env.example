# Environment Variables — QueryFlow Server

# Port to run the Express server on (default: 3001)
PORT=3001

# Secret for signing express-session cookies
# IMPORTANT: Change this to a long random string in production!
SESSION_SECRET=change-me-to-a-long-random-string

# Client origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development
